#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        Delette {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        Insert {
            bindings = <&kp INSERT>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <19 18>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <32 31>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <30 31>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                                 &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G      &kp LS(LG(S))               &kp HOME       &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z      &kp X         &kp C         &kp V                        &kp B      &kp LEFT_SHIFT              &kp END        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 INT_HENKAN  &lt 3 TAB  &lt_to_layer_0 2 SPACE      &kp BACKSPACE  &lt 1 ENTER                             &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&kp F1            &kp F2            &kp F3        &kp F4  &kp F5                                      &kp F6  &kp F7           &kp F8    &kp F9     &kp F10
&kp C_VOLUME_UP   &kp C_VOL_DN      &trans        &trans  &trans   &trans              &kp PAGE_UP    &trans  &kp PRINTSCREEN  &kp UP    &kp F11    &kp F12
&kp INT_HENKAN    &kp INT_MUHENKAN  &trans        &trans  &trans   &kp LEFT_SHIFT      &kp PAGE_DOWN  &trans  &kp LEFT         &kp DOWN  &kp RIGHT  &trans
&kp LEFT_CONTROL  &kp LEFT_WIN      &kp LEFT_ALT  &trans  &kp TAB  &kp SPACE           &kp BACKSPACE  &trans                                        &kp RIGHT_SHIFT
            >;
        };

        NUM {
            bindings = <
&kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                      &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&trans            &trans        &trans        &trans        &trans   &trans              &kp HOME       &trans        &kp PLUS      &kp ASTERISK  &kp AT_SIGN   &kp MINUS
&trans            &trans        &trans        &trans        &trans   &kp LEFT_SHIFT      &kp END        &trans        &trans        &kp COMMA     &kp PERIOD    &kp SLASH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &trans        &kp TAB  &kp SPACE           &kp BACKSPACE  &kp ENTER                                               &mt RIGHT_SHIFT EQUAL
            >;
        };

        MARK {
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH          &kp LC(DOLLAR)     &kp PERCENT                                     &kp AMPERSAND  &kp SQT   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans           &trans             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans       &trans              &kp PAGE_UP    &trans         &kp PLUS  &kp ASTERISK          &kp AT_SIGN            &kp CARET
&kp INT_HENKAN   &kp INT_MUHENKAN   &trans            &trans             &trans       &kp LEFT_SHIFT      &kp PAGE_DOWN  &trans         &trans    &kp SEMICOLON         &kp COLON              &kp INT_YEN
&kp LCTRL        &kp LEFT_WIN       &kp LEFT_ALT      &trans             &kp TAB      &kp SPACE           &kp BACKSPACE  &kp ENTER                                                             &mt RIGHT_SHIFT EQUAL
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
